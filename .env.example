# ---------------------------------------------------------------------------
# Easy Logi environment variables. Copy to .env.local and fill in.
# NEVER commit real secrets. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local dev DB connection (supabase start prints this)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Claude / Anthropic (Phase 1+) ------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp Cloud API (buyers, Phase 1+) ----------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Supplier inbound email webhook (Phase 2+) ------------------------------
EMAIL_WEBHOOK_SIGNING_SECRET=

# --- App config -------------------------------------------------------------
# Base URL used to build magic-link pages (apps/pages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign magic-link tokens (packages/shared/src/magicLink.ts). REQUIRED in any real
# environment; the mock uses a clearly-insecure dev fallback when unset.
MAGIC_LINK_SECRET=
# Comma-separated FX provider config (Phase 2); never hard-code rates in code.
FX_PROVIDER_API_KEY=
