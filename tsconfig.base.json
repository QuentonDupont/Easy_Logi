{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,

    "baseUrl": ".",
    "paths": {
      "@easy-logi/shared": ["packages/shared/src/index.ts"],
      "@easy-logi/shared/*": ["packages/shared/src/*"],
      "@easy-logi/costing": ["packages/costing/src/index.ts"],
      "@easy-logi/costing/*": ["packages/costing/src/*"]
    }
  }
}
